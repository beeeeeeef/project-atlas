{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.dev/schemas/insights.schema.json",
  "title": "insights.json",
  "description": "解释输入：概览介绍、卡片职责、关键链路。模型只能对已存在的节点写解释。",
  "type": "object",
  "required": ["intro", "flows"],
  "additionalProperties": false,
  "properties": {
    "intro": {
      "type": "object",
      "required": ["paragraphs"],
      "additionalProperties": false,
      "properties": {
        "paragraphs": {
          "type": "array", "minItems": 2,
          "items": { "type": "string", "minLength": 20 },
          "description": "2–4 段连续文字：是什么、给谁用、怎么组织、为什么这么设计"
        },
        "basis": { "type": "array", "items": { "type": "string" }, "description": "写这段介绍时读了哪些文件" }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/insight" }] }
    },
    "files": {
      "type": "object",
      "additionalProperties": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/fileInsight" }] }
    },
    "functions": {
      "type": "object",
      "additionalProperties": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/insight" }] },
      "description": "key 形如 <路径>::<标签>，如 pkg/client.py::Client.send()"
    },
    "startHere": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node"],
        "properties": { "node": { "type": "string" }, "why": { "type": "string" } }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string" },
          "steps": {
            "type": "array", "minItems": 2, "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["view", "node"],
              "additionalProperties": false,
              "properties": {
                "view": { "type": "string" },
                "node": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "why": { "type": "string" },
        "risk": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "fileInsight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "role": { "type": "string" },
        "why": { "type": "string" },
        "risk": { "type": "string" }
      }
    }
  }
}
